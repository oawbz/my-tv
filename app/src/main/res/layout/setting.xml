<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:background="@drawable/setting_panel">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="#40FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="频道列表地址"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/channels_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="textUri"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#99FFFFFF"
            android:hint="http://192.168.1.233:2219/channels.json" />
        <Button
            android:id="@+id/save_channels_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存并重新加载" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="播放器"
                android:textColor="#FFFFFFFF" />
            <Spinner
                android:id="@+id/player_engine"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:popupBackground="#FF20242C"
                android:dropDownWidth="match_parent"
                android:spinnerMode="dropdown" />
        </LinearLayout>
        <Switch
            android:id="@+id/switch_channel_reversal"
            android:text="@string/title_channel_reversal"
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Switch
            android:id="@+id/switch_channel_number_input"
            android:text="启用数字键盘"
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Switch
            android:id="@+id/switch_boot_startup"
            android:text="@string/title_boot_startup"
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/close_mobile_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关闭"
 />
    </LinearLayout>
</ScrollView>
